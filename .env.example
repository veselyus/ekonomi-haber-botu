# Google Gemini API Anahtarı (Zorunlu - https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Ayarları (--dry-run haricinde zorunlu)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# Model ve Puanlama Eşikleri (İsteğe Bağlı)
GEMINI_MODEL=gemini-3.5-flash-lite
CRITICAL_SCORE_THRESHOLD=10
DIGEST_SCORE_THRESHOLD=7

# Filtreleme ve Tekilleştirme Ayarları (İsteğe Bağlı)
MAX_ARTICLE_AGE_HOURS=24
FUZZY_DUPLICATE_THRESHOLD=80.0
BATCH_SIZE=20
SEND_EMPTY_DIGEST=false

# Veritabanı Yolu (İsteğe Bağlı)
DATABASE_PATH=data/news_state.db
LOG_LEVEL=INFO

